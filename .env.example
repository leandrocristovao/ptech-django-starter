# Django
# Copy this file to .env. core.settings loads .env automatically when present.
DJANGO_SETTINGS_MODULE=core.settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=America/Sao_Paulo

# Database
# SQLite is the default and needs no extra package.
DJANGO_DATABASE_ENGINE=sqlite

# MySQL example
# DJANGO_DATABASE_ENGINE=mysql
# MYSQL_DATABASE=ptech_django_starter
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_EAGER_PROPAGATES=1
